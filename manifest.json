{
  "manifest_version": 3,
  "name": "Bahria LMS Redesign",
  "version": "3.8",
  "description": "Modern UI redesign for Bahria University LMS and CMS — clean layout, anime style, glass panels over your own wallpaper, dark mode and 13 full-palette themes.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LMS Redesign Settings",
    "default_icon": {
      "16": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  },
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "js/background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Switch between light and dark mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://lms.bahria.edu.pk/*"],
      "css": ["css/theme.css", "css/mystyle.css", "css/anime.css"],
      "js": ["js/settings.js", "js/theme-core.js", "js/content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://cms.bahria.edu.pk/*"],
      "css": ["css/theme.css", "css/cms-style.css", "css/anime.css"],
      "js": ["js/settings.js", "js/theme-core.js", "js/cms-content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2", "images/wallpapers/*.svg"],
      "matches": ["*://lms.bahria.edu.pk/*", "*://cms.bahria.edu.pk/*"]
    }
  ]
}
